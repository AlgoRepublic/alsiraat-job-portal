# Server Configuration
PORT=5001
MONGODB_URI=mongodb://dev****:SBguApHCltSCdmCU366qFKufU9eSRgnK1P9EqkZ7TmY7VxO7@12a49dbc-efe5-41c8-970e-db04e6b737b6.northamerica-northeast2.firestore.goog:443/tasker?loadBalanced=true&tls=true&authMechanism=SCRAM-SHA-256&retryWrites=false
JWT_SECRET=your_jwt_secret_here

# Google OAuth
# Client ID from Google Cloud Console (Web Application)
GOOGLE_CLIENT_ID=192907644387-a3amcqep2r3muv9v23tmmt70iugn1aei9.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# For local development:
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback
# For production: https://tasker.alsirat.vic.edu.au/api/auth/google/callback
# For staging: https://tasker-prod.alsirat.vic.edu.au/api/auth/google/callback
# For dev: https://tasker-dev.alsirat.vic.edu.au/api/auth/google/callback
# For test: https://tasker-test.alsirat.vic.edu.au/api/auth/google/callback

# OpenID Connect Authentication (ADFS)
# The issuer URL will automatically discover endpoints from .well-known/openid-configuration
# Using public client flow (no client secret required)
OIDC_ISSUER=https://adfs.alsiraat.vic.edu.au/adfs
OIDC_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxx
OIDC_CALLBACK_URL=http://localhost:5001/api/auth/oidc/callback

# Optional: Map ADFS role/group names to Taskunity roles (comma-separated "adfs_value:Taskunity Role")
# Example: OIDC_ROLE_MAPPING=School-Staff:Organisation Admin,Teachers:Task Advertiser
OIDC_ROLE_MAPPING=

# Optional: ADFS claim values (exact strings) that grant platform super-admin (User.isSuperAdmin). Comma-separated.
# Example: OIDC_SUPERADMIN_MAPPING=TaskUnity-Admins,ADFS-Platform-Admins
OIDC_SUPERADMIN_MAPPING=

# Debug: Log decoded ID/access token claims and extracted roles/groups during SSO login (never enable in production)
OIDC_DEBUG_CLAIMS=false

# Redis (BullMQ) — required for background email delivery. When unset, the API sends mail inline.
# Local: redis://localhost:6379  |  Docker Compose: redis://redis:6379
REDIS_URL=

# Email: all configuration is per-organisation in the database (EmailSettings).
# Configure SMTP or Azure Communication Services in Admin → Email Notification Settings.
# No email-related env vars are used for sending.

# Optional fallback slug when no organisation has isCentralOrg=true (prefer the DB flag).
# CENTRAL_ORG_SLUG=tasker-central

# Frontend API URL (same as VITE_API_URL on the SPA). Email links use the origin with /api stripped.
FE_VITE_API_URL=http://localhost:5001/api
# Legacy fallback if FE_VITE_API_URL is unset
FRONTEND_URL=http://localhost:5173
